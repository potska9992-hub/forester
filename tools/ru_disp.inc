// ==== RU-BEGIN (generated by tools/gen_ru.py from tools/dict_ru.py - do not edit by hand) ====
// Russian UI: the display class translates every printed English string through a dictionary
// and draws Cyrillic letters itself (the built-in font has none). No call site needs to know the language.
#define LANG_EN 0
#define LANG_RU 1
static const uint8_t RU_GLYPH[64][8] = {   // 32 capitals, 32 lowercase; 5 columns in the low bits, row 7 = descender
@GLYPHS@
};
struct RuTr { const char* en; const char* ru; };
static const RuTr RU_TR[@NTAB@] = {
@TAB@
};
struct RuIdx { uint16_t s, n; };
static const RuIdx RU_IDX[128] = { @IDX@ };

static inline bool ruIsLetter(char c) { c |= 0x20; return c >= 'a' && c <= 'z'; }
static inline char ruLow(char c) { return (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c; }

// copy a dictionary value: mode 0 as is, 1 all capitals, 2 first letter capital
static char* ruPut(char* o, char* end, const char* s, uint8_t mode) {
  bool first = true;
  while (*s && o + 2 < end) {
    uint8_t c = (uint8_t)*s++;
    if (c < 0x80) {
      if ((mode == 1 || (mode == 2 && first)) && c >= 'a' && c <= 'z') c -= 32;
      *o++ = (char)c;
      first = false;
    } else {
      uint8_t d = (uint8_t)*s++;
      if (mode == 1 || (mode == 2 && first)) {
        if (c == 0xD0 && d >= 0xB0 && d <= 0xBF) d -= 0x20;                 // а-п -> А-П
        else if (c == 0xD1 && d >= 0x80 && d <= 0x8F) { c = 0xD0; d += 0x20; }   // р-я -> Р-Я
      }
      *o++ = (char)c; *o++ = (char)d;
      first = false;
    }
  }
  return o;
}

// English text -> Russian text (longest dictionary match at every word start)
static size_t ruTranslate(const char* in, size_t n, char* out, size_t cap) {
  size_t i = 0;
  char* o = out;
  char* end = out + cap - 1;
  while (i < n && o + 2 < end) {
    uint8_t ch = (uint8_t)in[i];
    int best = -1;
    size_t bestLen = 0;
    if (ch < 128 && !(i > 0 && ruIsLetter(in[i - 1]))) {
      const RuIdx& ix = RU_IDX[(uint8_t)ruLow((char)ch)];
      for (uint16_t k = 0; k < ix.n; k++) {
        const char* en = RU_TR[ix.s + k].en;
        size_t L = strlen(en);
        if (L <= bestLen || i + L > n) continue;
        size_t j = 0;
        while (j < L && ruLow(in[i + j]) == en[j]) j++;
        if (j < L) continue;
        if (ruIsLetter(en[L - 1]) && i + L < n && ruIsLetter(in[i + L])) continue;   // only whole words
        best = ix.s + k; bestLen = L;
      }
    }
    if (best < 0) { out[o - out] = in[i]; o++; i++; continue; }
    int up = 0, lo = 0; bool firstUp = false, got = false;
    for (size_t j = 0; j < bestLen; j++) {
      char c = in[i + j];
      if (!ruIsLetter(c)) continue;
      bool u = c >= 'A' && c <= 'Z';
      if (!got) { firstUp = u; got = true; }
      if (u) up++; else lo++;
    }
    uint8_t mode = (lo == 0 && up >= 2) ? 1 : (firstUp ? 2 : 0);
    o = ruPut(o, end, RU_TR[best].ru, mode);
    i += bestLen;
  }
  *o = 0;
  return (size_t)(o - out);
}

class Disp : public Adafruit_SH1106G {
 public:
  using Adafruit_SH1106G::Adafruit_SH1106G;
  uint8_t lang = LANG_EN;     // язык интерфейса
  bool raw = false;           // true: печатать как есть (лог из Serial)

  size_t write(uint8_t c) override {
    if (c < 0x80) { u8 = 0; return Adafruit_SH1106G::write(c); }
    if (c >= 0xC0) { u8 = c; return 1; }
    uint8_t lead = u8;
    u8 = 0;
    int id = -1;
    if (lead == 0xD0) {
      if (c >= 0x90 && c <= 0xAF) id = c - 0x90;
      else if (c >= 0xB0 && c <= 0xBF) id = 32 + (c - 0xB0);
      else if (c == 0x81) id = 5;                      // Ё -> Е
    } else if (lead == 0xD1) {
      if (c >= 0x80 && c <= 0x8F) id = 48 + (c - 0x80);
      else if (c == 0x91) id = 37;                     // ё -> е
    }
    if (id >= 0) ruDraw(id);
    return 1;
  }
  size_t write(const uint8_t* b, size_t n) override {
    if (lang == LANG_RU && !raw) {
      char t[160];
      size_t m = ruTranslate((const char*)b, n, t, sizeof(t));
#ifdef PULT_HARNESS
      Print::write((const uint8_t*)t, m);
#else
      for (size_t i = 0; i < m; i++) write((uint8_t)t[i]);
#endif
      return n;
    }
    return Print::write(b, n);        // Adafruit_GFX прячет эту перегрузку, поэтому имя класса указываем явно
  }
 // сколько знакомест займет строка на экране (после перевода)
  int chars(const char* str) {
    char t[160];
    size_t n = strlen(str);
    if (lang == LANG_RU && !raw) { n = ruTranslate(str, n, t, sizeof(t)); str = t; }
    int c = 0;
    for (size_t i = 0; i < n; i++) if (((uint8_t)str[i] & 0xC0) != 0x80) c++;
    return c;
  }
 // вывод текста пользователя (имена сетей, вводимый текст) без перевода
  void printRaw(const char* str) { raw = true; print(str); raw = false; }
  void printfRaw(const char* fmt, ...) {
    char t[96];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(t, sizeof(t), fmt, ap);
    va_end(ap);
    printRaw(t);
  }
 private:
  uint8_t u8 = 0;
  void ruDraw(int id) {
    const uint8_t* g = RU_GLYPH[id];
    int sx = textsize_x, sy = textsize_y;
    if (wrap && cursor_x + sx * 6 > _width) { cursor_x = 0; cursor_y += sy * 8; }
    for (int r = 0; r < 8; r++) {
      for (int c = 0; c < 6; c++) {
        bool on = c < 5 && ((g[r] >> (4 - c)) & 1);
        if (!on && textbgcolor == textcolor) continue;
        uint16_t col = on ? textcolor : textbgcolor;
        if (sx == 1 && sy == 1) drawPixel(cursor_x + c, cursor_y + r, col);
        else fillRect(cursor_x + c * sx, cursor_y + r * sy, sx, sy, col);
      }
    }
    cursor_x += sx * 6;
  }
};
// ==== RU-END ====
